APP_ENV=development
APP_DEBUG=0

# Public identity. NIGHTCORE_SERVER_NAME avoids collision with CGI/FastCGI SERVER_NAME.
NIGHTCORE_SERVER_NAME=My GDPS
SERVER_ID=my-gdps
CORE_PROFILE=cvolton
BASE_PATH=/

# Database. DB_DSN may be used instead for advanced deployments.
DB_DSN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gdps
DB_USER=gdps
DB_PASS=
DB_CHARSET=utf8mb4

# Optional prefix lets multiple fresh Night Core installations share one database.
# Existing Cvolton databases normally leave this empty.
CORE_TABLE_PREFIX=

# Account compatibility.
ACCOUNT_PREACTIVATE=1
LEGACY_MIGRATE_UDID_LEVELS=1

# Login protection. Set AUTH_MAX_ATTEMPTS=0 to disable.
AUTH_MAX_ATTEMPTS=8
AUTH_WINDOW_SECONDS=3600

# Newgrounds custom songs. Results are cached in core_songs; failed IDs are temporarily cached too.
NEWGROUNDS_FETCH_ENABLED=1
NEWGROUNDS_USE_BOOMLINGS_METADATA=1
NEWGROUNDS_DIRECT_FALLBACK=1
NEWGROUNDS_TIMEOUT_SECONDS=5
NEWGROUNDS_NEGATIVE_TTL_SECONDS=3600

# Level storage. Empty LEVEL_STORAGE_PATH uses <project>/data/levels.
LEVEL_STORAGE_PATH=
LEVEL_MAX_BYTES=8388608
LEVEL_UPLOAD_COOLDOWN_SECONDS=60

# Cloud-save payload cap (saveData + saveData2) in bytes.
SAVE_MAX_BYTES=16777216

# Optional bootstrap administrators. Comma-separated numeric account IDs.
# These IDs receive the universal core moderator/admin capabilities without
# requiring an initial row in core_moderator_roles. Leave empty by default.
CORE_ADMIN_ACCOUNT_IDS=

# Keep disabled unless requests arrive through a trusted reverse proxy such as Cloudflare/Nginx.
TRUST_PROXY_HEADERS=0
