# Night Core V1 production template.
# Copy to .env on the server and replace every CHANGE_ME value before deployment.

APP_ENV=production
APP_DEBUG=0

# Public GDPS identity. NIGHTCORE_SERVER_NAME avoids collision with CGI SERVER_NAME.
NIGHTCORE_SERVER_NAME=CHANGE_ME_GDPS_NAME
SERVER_ID=CHANGE_ME_GDPS_ID
CORE_PROFILE=cvolton
BASE_PATH=/

# MariaDB/MySQL. Use a dedicated non-root user with access only to this database.
DB_DSN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=CHANGE_ME_DATABASE
DB_USER=CHANGE_ME_DATABASE_USER
DB_PASS=CHANGE_ME_LONG_RANDOM_PASSWORD
DB_CHARSET=utf8mb4

# Leave empty for existing Cvolton-compatible databases unless a prefix is intentional.
CORE_TABLE_PREFIX=

# Account compatibility.
ACCOUNT_PREACTIVATE=1
LEGACY_MIGRATE_UDID_LEVELS=1

# Authentication abuse protection.
AUTH_MAX_ATTEMPTS=8
AUTH_WINDOW_SECONDS=3600

# Registration protection shared by the game endpoint and dashboard account panel.
# Use a separate long random value so stored IP/subnet identifiers are HMAC-only.
REGISTRATION_MAX_PER_IP=2
REGISTRATION_MAX_PER_SUBNET=10
REGISTRATION_WINDOW_SECONDS=86400
REGISTRATION_IP_HASH_KEY=CHANGE_ME_LONG_RANDOM_REGISTRATION_HASH_KEY

# Browser-panel login/audit identifiers. Use a different random key from DB credentials.
PANEL_SECURITY_HASH_KEY=CHANGE_ME_LONG_RANDOM_PANEL_HASH_KEY

# Newgrounds custom songs. Successful metadata is cached locally; failed IDs back off for an hour.
NEWGROUNDS_FETCH_ENABLED=1
NEWGROUNDS_USE_BOOMLINGS_METADATA=1
NEWGROUNDS_DIRECT_FALLBACK=1
NEWGROUNDS_TIMEOUT_SECONDS=5
NEWGROUNDS_NEGATIVE_TTL_SECONDS=3600

# Night Core-hosted custom songs. Keep MP3 files outside public/ and let downloadCustomSong.php serve them.
# Public /dashboard.php access and upload limits are controlled by private config/media.php.
CUSTOM_SONG_STORAGE_PATH=/var/lib/nightcore/songs
CUSTOM_SONG_MAX_BYTES=26214400
# Seven-digit IDs are used by default; change the range only if it is reserved for this GDPS.
CUSTOM_SONG_ID_MIN=2000000
CUSTOM_SONG_ID_MAX=8999999
# Optional canonical origin, e.g. https://gdps.example.com. Empty derives it from the uploader request.
CUSTOM_SONG_PUBLIC_BASE_URL=
# Long random secret only for the legacy /songAdmin.php owner page. Empty disables that legacy page.
CUSTOM_SONG_ADMIN_TOKEN=

# Night Core-hosted SFX. Keep Ogg files outside public/ as well.
CUSTOM_SFX_STORAGE_PATH=/var/lib/nightcore/sfx
CUSTOM_SFX_MAX_BYTES=10485760
CUSTOM_SFX_ID_MIN=2000000
CUSTOM_SFX_ID_MAX=8999999
# Optional canonical origin for SFX downloads. Blank falls back to the song origin/request host.
CUSTOM_SFX_PUBLIC_BASE_URL=

# Level storage. Prefer an absolute path outside the public document root.
LEVEL_STORAGE_PATH=/var/lib/nightcore/levels
LEVEL_MAX_BYTES=8388608
LEVEL_UPLOAD_COOLDOWN_SECONDS=60

# Cloud-save payload cap (saveData + saveData2) in bytes.
SAVE_MAX_BYTES=16777216

# Comma-separated account IDs that receive bootstrap admin capabilities.
CORE_ADMIN_ACCOUNT_IDS=

# Enable only when the origin is reachable exclusively through a trusted reverse proxy.
# For Cloudflare, also firewall the origin so clients cannot bypass Cloudflare and spoof proxy headers.
TRUST_PROXY_HEADERS=0
