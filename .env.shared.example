# Night Core V1 shared-hosting test template.
# Intended for temporary staging/core validation only.

APP_ENV=staging
APP_DEBUG=0

SERVER_NAME=Night Core Shared Test
SERVER_ID=night-core-shared-test
CORE_PROFILE=cvolton
BASE_PATH=/

DB_DSN=
DB_HOST=CHANGE_ME_DATABASE_HOST
DB_PORT=3306
DB_NAME=CHANGE_ME_DATABASE_NAME
DB_USER=CHANGE_ME_DATABASE_USER
DB_PASS=CHANGE_ME_DATABASE_PASSWORD
DB_CHARSET=utf8mb4

CORE_TABLE_PREFIX=
ACCOUNT_PREACTIVATE=1
LEGACY_MIGRATE_UDID_LEVELS=1
AUTH_MAX_ATTEMPTS=8
AUTH_WINDOW_SECONDS=3600

# Leave blank on shared hosting so Night Core uses <repo>/data/levels.
# The root .htaccess prevents public access to that directory.
LEVEL_STORAGE_PATH=
LEVEL_MAX_BYTES=8388608
LEVEL_UPLOAD_COOLDOWN_SECONDS=60
SAVE_MAX_BYTES=16777216

CORE_ADMIN_ACCOUNT_IDS=
TRUST_PROXY_HEADERS=0

# Enables the temporary browser installer at /install.php.
# Use a long random value, run the installer once, then set this back to empty.
WEB_INSTALL_TOKEN=CHANGE_ME_LONG_RANDOM_INSTALL_TOKEN
