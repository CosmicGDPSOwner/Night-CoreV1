# Night Core V1 staging template.
# Copy to .env on the staging origin and replace CHANGE_ME values.

APP_ENV=staging
APP_DEBUG=0

# Staging identity must be distinguishable from production.
NIGHTCORE_SERVER_NAME=Night Core Staging
SERVER_ID=night-core-staging
CORE_PROFILE=cvolton
BASE_PATH=/

# Dedicated staging MariaDB/MySQL database. Never point staging at the production database.
DB_DSN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nightcore_staging
DB_USER=nightcore_staging
DB_PASS=CHANGE_ME_LONG_RANDOM_PASSWORD
DB_CHARSET=utf8mb4

# Docker Compose uses this only to initialize the private MariaDB container.
# Night Core itself does not use the root password.
MARIADB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_LONG_RANDOM_PASSWORD
STAGING_HTTP_PORT=8080

# Keep staging isolated even when a database server is shared.
CORE_TABLE_PREFIX=

# Match production compatibility behavior unless a specific test requires otherwise.
ACCOUNT_PREACTIVATE=1
LEGACY_MIGRATE_UDID_LEVELS=1

# Authentication abuse protection.
AUTH_MAX_ATTEMPTS=8
AUTH_WINDOW_SECONDS=3600

# Newgrounds custom songs.
NEWGROUNDS_FETCH_ENABLED=1
NEWGROUNDS_USE_BOOMLINGS_METADATA=1
NEWGROUNDS_DIRECT_FALLBACK=1
NEWGROUNDS_TIMEOUT_SECONDS=5
NEWGROUNDS_NEGATIVE_TTL_SECONDS=3600

# Night Core-hosted custom songs. Keep staging song files separate from production.
CUSTOM_SONG_STORAGE_PATH=/var/lib/nightcore-staging/songs
CUSTOM_SONG_MAX_BYTES=26214400
CUSTOM_SONG_PUBLIC_BASE_URL=
CUSTOM_SONG_ADMIN_TOKEN=

# Keep staging level payloads outside the public document root and separate from production.
# compose.staging.yml overrides this inside the container with /var/lib/nightcore/levels.
LEVEL_STORAGE_PATH=/var/lib/nightcore-staging/levels
LEVEL_MAX_BYTES=8388608
LEVEL_UPLOAD_COOLDOWN_SECONDS=60

# Cloud-save payload cap (saveData + saveData2) in bytes.
SAVE_MAX_BYTES=16777216

# Leave empty until a known staging account should receive bootstrap admin capabilities.
CORE_ADMIN_ACCOUNT_IDS=

# Enable only after the staging origin is restricted to the trusted reverse proxy.
TRUST_PROXY_HEADERS=0
