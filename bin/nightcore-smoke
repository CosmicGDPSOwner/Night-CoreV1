#!/usr/bin/env php
<?php

declare(strict_types=1);

/** @return array{status:int,body:string,error:?string} */
function nightcoreSmokeGet(string $url): array
{
    if (function_exists('curl_init')) {
        $handle = curl_init($url);
        if ($handle === false) {
            return ['status' => 0, 'body' => '', 'error' => 'Unable to initialize cURL.'];
        }

        curl_setopt_array($handle, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => false,
            CURLOPT_CONNECTTIMEOUT => 5,
            CURLOPT_TIMEOUT => 10,
            CURLOPT_USERAGENT => 'NightCore-Staging-Smoke/1.0',
        ]);

        $body = curl_exec($handle);
        $error = $body === false ? curl_error($handle) : null;
        $status = (int) curl_getinfo($handle, CURLINFO_RESPONSE_CODE);
        curl_close($handle);

        return [
            'status' => $status,
            'body' => is_string($body) ? $body : '',
            'error' => $error,
        ];
    }

    if (!filter_var(ini_get('allow_url_fopen'), FILTER_VALIDATE_BOOLEAN)) {
        return [
            'status' => 0,
            'body' => '',
            'error' => 'Neither cURL nor allow_url_fopen is available.',
        ];
    }

    $context = stream_context_create([
        'http' => [
            'method' => 'GET',
            'timeout' => 10,
            'ignore_errors' => true,
            'header' => "User-Agent: NightCore-Staging-Smoke/1.0\r\nConnection: close\r\n",
        ],
    ]);

    $body = @file_get_contents($url, false, $context);
    $headers = $http_response_header ?? [];
    $status = 0;
    if (isset($headers[0]) && preg_match('/\s(\d{3})\s/', $headers[0], $match)) {
        $status = (int) $match[1];
    }

    return [
        'status' => $status,
        'body' => is_string($body) ? $body : '',
        'error' => $body === false ? 'HTTP request failed.' : null,
    ];
}

$baseUrl = trim($argv[1] ?? '');
if ($baseUrl === '') {
    fwrite(STDERR, "Usage: php bin/nightcore-smoke https://staging-api.example.com\n");
    exit(64);
}

$parts = parse_url($baseUrl);
if (!is_array($parts) || !isset($parts['scheme'], $parts['host']) || !in_array(strtolower((string) $parts['scheme']), ['http', 'https'], true)) {
    fwrite(STDERR, "Invalid base URL. Use an absolute http:// or https:// URL.\n");
    exit(64);
}

$baseUrl = rtrim($baseUrl, '/');
$failures = [];

$health = nightcoreSmokeGet($baseUrl . '/health.php');
if ($health['status'] !== 200 || trim($health['body']) !== 'ok') {
    $failures[] = sprintf('health.php expected HTTP 200/ok, got HTTP %d%s', $health['status'], $health['error'] !== null ? ' (' . $health['error'] . ')' : '');
} else {
    echo "[OK] health.php\n";
}

$ready = nightcoreSmokeGet($baseUrl . '/ready.php');
if ($ready['status'] !== 200 || trim($ready['body']) !== 'ready') {
    $failures[] = sprintf('ready.php expected HTTP 200/ready, got HTTP %d%s', $ready['status'], $ready['error'] !== null ? ' (' . $ready['error'] . ')' : '');
} else {
    echo "[OK] ready.php\n";
}

$info = nightcoreSmokeGet($baseUrl . '/info.php');
$payload = json_decode($info['body'], true);
if (
    $info['status'] !== 200 ||
    !is_array($payload) ||
    ($payload['core'] ?? null) !== 'Night Core V1' ||
    trim((string) ($payload['server'] ?? '')) === '' ||
    trim((string) ($payload['profile'] ?? '')) === ''
) {
    $failures[] = sprintf('info.php returned an invalid Night Core response (HTTP %d)%s', $info['status'], $info['error'] !== null ? ' (' . $info['error'] . ')' : '');
} else {
    echo '[OK] info.php (' . $payload['server'] . ', profile=' . $payload['profile'] . ")\n";
}

if ($failures !== []) {
    foreach ($failures as $failure) {
        fwrite(STDERR, '[FAIL] ' . $failure . PHP_EOL);
    }
    exit(2);
}

echo "Night Core staging smoke: OK\n";
